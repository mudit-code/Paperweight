{
  "name": "paperweight",
  "private": true,
  "version": "0.2.34",
  "description": "Offline document and image workspace. Convert, compress, resize, and scan — runs fully on your device.",
  "author": "Paperweight",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --config electron-builder.json && node scripts/sync-installer.mjs",
    "installer": "npm run build && node scripts/generate-installer-icons.mjs && electron-builder --config electron-builder.json && node scripts/sync-installer.mjs",
    "apk": "npm run build && npx cap sync android && node scripts/build-apk.mjs",
    "assets": "node scripts/generate-all-assets.mjs",
    "website": "node scripts/serve-website.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
